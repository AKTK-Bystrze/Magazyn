---
/**
 * AppLayout - Standard user application layout
 * 
 * Includes navigation bar configured for regular users with:
 * - Dashboard, Equipment, Reservations, Credits links
 * - User menu with logout
 * - Breadcrumbs for nested pages
 * 
 * @example
 * <AppLayout title="My Reservations">
 *   <ReservationsContainer client:load />
 * </AppLayout>
 */
import BaseLayout from './BaseLayout.astro';
import { UserSidebar } from '@/components/navigation/UserSidebar';
import { AdminSidebar } from '@/components/admin/AdminSidebar';
import { UserHeader } from '@/components/navigation/UserHeader';
import { QueryProvider } from '@/components/providers/QueryProvider';

interface Props {
  /** Page title displayed in browser tab */
  title: string;
  /** Optional meta description */
  description?: string;
  /** Whether to show breadcrumbs (deprecated, handled by header) */
  showBreadcrumbs?: boolean;
}

const { title, description } = Astro.props;

const user = Astro.locals.user;
const sessionInfo = Astro.locals.sessionInfo;
const currentPath = Astro.url.pathname;

// Determine if user is admin
const isAdmin = sessionInfo?.role === 'admin' || sessionInfo?.role === 'super_admin';
---

<BaseLayout title={title} description={description}>
  <div id="app-layout" class="flex min-h-screen w-full">
    {/* Desktop Sidebar Container */}
    <div 
      id="desktop-sidebar-container" 
      class="hidden lg:block w-[280px] shrink-0 border-r bg-muted/40 overflow-hidden transition-[width] duration-300 data-[collapsed=true]:w-0 data-[collapsed=true]:border-r-0"
    >
      <div class="w-[280px] h-full flex flex-col gap-2">
        {
          isAdmin ? (
            <AdminSidebar client:load currentPath={currentPath} />
          ) : (
            <UserSidebar client:load currentPath={currentPath} />
          )
        }
      </div>
    </div>

    {/* Main Content Area */}
    <div class="flex flex-col flex-1 min-w-0 transition-all duration-300">
      <QueryProvider client:load>
        <UserHeader
          client:load
          user={user ? { email: user.email || "", id: user.id } : null}
          currentPath={currentPath}
          creditBalance={sessionInfo?.creditBalance}
          isAdmin={isAdmin}
        />
      </QueryProvider>

      <main class="flex flex-1 flex-col gap-4 p-4 lg:gap-6 lg:p-6 min-w-0">
        <slot />
      </main>
    </div>
  </div>

  <script is:inline>
    // Apply initial sidebar state to prevent flicker
    (function () {
      const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
      const container = document.getElementById('desktop-sidebar-container');
      if (container && isCollapsed) {
        container.dataset.collapsed = 'true';
      }
    })();
  </script>
</BaseLayout>
