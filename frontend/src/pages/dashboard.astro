---
import Layout from '../layouts/Layout.astro';
import { ROUTES } from '../lib/config/routes';
import { ADMIN_ROLE, SUPER_ADMIN_ROLE } from '../lib/auth/roles';

// Check if user is authenticated - middleware handles this
const user = Astro.locals.user;
const sessionInfo = Astro.locals.sessionInfo;

console.log(`[DASHBOARD_PAGE] Accessing page. User: ${user?.email}`);

if (!user) {
  console.log(`[DASHBOARD_PAGE] No user found. Redirecting to ${ROUTES.PUBLIC.LOGIN}`);
  return Astro.redirect(ROUTES.PUBLIC.LOGIN);
}

// SECURITY: Use ONLY sessionInfo.role (authoritative source from database with RLS)
if (!sessionInfo || !sessionInfo.role) {
  console.log(`[DASHBOARD_PAGE] No sessionInfo available. Redirecting to ${ROUTES.PUBLIC.LOGIN}`);
  return Astro.redirect(ROUTES.PUBLIC.LOGIN);
}

console.log(`[DASHBOARD_PAGE] User Role: ${sessionInfo.role} (from sessionInfo - authoritative source)`);

// Only regular users should access dashboard
// Admins should be redirected to /admin
if (sessionInfo.role === ADMIN_ROLE || sessionInfo.role === SUPER_ADMIN_ROLE) {
  console.log(`[DASHBOARD_PAGE] User is admin. Redirecting to ${ROUTES.PROTECTED.ADMIN}`);
  return Astro.redirect(ROUTES.PROTECTED.ADMIN);
}
---

<Layout title="Dashboard | Equipment Rental">
  <main class="flex min-h-screen flex-col items-center justify-center p-24">
    <h1 class="text-4xl font-bold">User Dashboard</h1>
    <p class="mt-4 text-xl">Welcome, {user.email}!</p>
    <p class="mt-2 text-muted-foreground">This is your personal dashboard.</p>
    
    <div class="mt-8 flex gap-4">
      <a href="/equipment" class="px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90">
        Browse Equipment
      </a>
      <a href="/reservations" class="px-4 py-2 bg-secondary text-secondary-foreground rounded-md hover:bg-secondary/90">
        My Reservations
      </a>
    </div>
  </main>
</Layout>
