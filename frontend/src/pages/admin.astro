---
/**
 * Admin Dashboard Page - Admin home page
 * Displays admin dashboard with quick actions.
 */
import AdminLayout from '../layouts/AdminLayout.astro';
import { ROUTES } from '../lib/config/routes';
import { ADMIN_ROLE, SUPER_ADMIN_ROLE } from '../lib/auth/roles';
import { DashboardStats } from '@/components/admin/DashboardStats';

const user = Astro.locals.user;
const sessionInfo = Astro.locals.sessionInfo;

if (!user) {
  return Astro.redirect(ROUTES.PUBLIC.LOGIN);
}

if (!sessionInfo || !sessionInfo.role) {
  return Astro.redirect(ROUTES.PUBLIC.LOGIN);
}

const userRole = sessionInfo.role;

if (userRole !== ADMIN_ROLE && userRole !== SUPER_ADMIN_ROLE) {
  return Astro.redirect(ROUTES.PROTECTED.DASHBOARD);
}
---

<AdminLayout title="Admin Dashboard | Magazyn">
  <div class="flex flex-col gap-6">
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-bold tracking-tight">Dashboard</h1>
    </div>

    {/* Stats Overview */}
    <DashboardStats client:load />

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-7">
      {/* Quick Actions / Recent Activity Area */}
      <div class="col-span-4 lg:col-span-4">
        <div class="rounded-xl border bg-card text-card-foreground shadow">
          <div class="flex flex-col space-y-1.5 p-6">
            <h3 class="font-semibold leading-none tracking-tight">Quick Actions</h3>
            <p class="text-sm text-muted-foreground">Common administrative tasks.</p>
          </div>
          <div class="p-6 pt-0 grid gap-4 md:grid-cols-2">
            <a 
              href={ROUTES.PROTECTED.ADMIN_RESERVATIONS}
              class="group flex flex-col items-center justify-center gap-2 rounded-lg border p-4 hover:bg-accent hover:text-accent-foreground transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 text-muted-foreground group-hover:text-primary transition-colors">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span class="font-medium">Manage Reservations</span>
            </a>
            
            <a 
              href={ROUTES.PROTECTED.ADMIN_EQUIPMENT}
              class="group flex flex-col items-center justify-center gap-2 rounded-lg border p-4 hover:bg-accent hover:text-accent-foreground transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 text-muted-foreground group-hover:text-primary transition-colors">
                 <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
              </svg>
              <span class="font-medium">Manage Equipment</span>
            </a>

            {userRole === SUPER_ADMIN_ROLE && (
              <a 
                href={ROUTES.PROTECTED.ADMIN_USERS}
                class="group flex flex-col items-center justify-center gap-2 rounded-lg border p-4 hover:bg-accent hover:text-accent-foreground transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 text-muted-foreground group-hover:text-primary transition-colors">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <span class="font-medium">Manage Users</span>
              </a>
            )}

            <a 
              href={ROUTES.PROTECTED.ADMIN_ANALYTICS}
              class="group flex flex-col items-center justify-center gap-2 rounded-lg border p-4 hover:bg-accent hover:text-accent-foreground transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 text-muted-foreground group-hover:text-primary transition-colors">
                <line x1="12" y1="20" x2="12" y2="10"></line>
                <line x1="18" y1="20" x2="18" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="16"></line>
              </svg>
              <span class="font-medium">View Analytics</span>
            </a>
          </div>
        </div>
      </div>

      {/* Profile / Info Card */}
      <div class="col-span-4 lg:col-span-3">
        <div class="rounded-xl border bg-card text-card-foreground shadow h-full">
          <div class="flex flex-col space-y-1.5 p-6">
            <h3 class="font-semibold leading-none tracking-tight">Admin Profile</h3>
            <p class="text-sm text-muted-foreground">Current session details.</p>
          </div>
          <div class="p-6 pt-0">
             <div class="flex items-center space-x-4 mb-4">
                <div class="h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center">
                  <span class="text-lg font-bold text-primary">{user.email?.charAt(0).toUpperCase()}</span>
                </div>
                <div>
                  <p class="text-sm font-medium leading-none">{user.email}</p>
                  <p class="text-xs text-muted-foreground capitalize mt-1">{userRole.replace('_', ' ')}</p>
                </div>
             </div>
             <p class="text-sm text-muted-foreground">
               You are currently logged in as {userRole.replace('_', ' ')}. You have full access to manage reservations, equipment, and user accounts.
             </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
