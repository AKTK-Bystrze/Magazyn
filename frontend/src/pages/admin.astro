---
import Layout from '../layouts/Layout.astro';
import { ROUTES } from '../lib/config/routes';
import { ADMIN_ROLE, SUPER_ADMIN_ROLE } from '../lib/auth/roles';

// Check if user is authenticated - middleware handles this
const user = Astro.locals.user;
const sessionInfo = Astro.locals.sessionInfo;

console.log(`[ADMIN_PAGE] Accessing page. User: ${user?.email}`);

if (!user) {
  console.log(`[ADMIN_PAGE] No user found. Redirecting to ${ROUTES.PUBLIC.LOGIN}`);
  return Astro.redirect(ROUTES.PUBLIC.LOGIN);
}

// SECURITY: Use ONLY sessionInfo.role (authoritative source from database with RLS)
// Never use user_metadata.role (can be stale)
if (!sessionInfo || !sessionInfo.role) {
  console.log(`[ADMIN_PAGE] No sessionInfo available. Redirecting to ${ROUTES.PUBLIC.LOGIN}`);
  return Astro.redirect(ROUTES.PUBLIC.LOGIN);
}

const userRole = sessionInfo.role;
console.log(`[ADMIN_PAGE] User Role: ${userRole} (from sessionInfo - authoritative source)`);

if (userRole !== ADMIN_ROLE && userRole !== SUPER_ADMIN_ROLE) {
  console.log(`[ADMIN_PAGE] Invalid role '${userRole}'. Redirecting to ${ROUTES.PROTECTED.DASHBOARD}`);
  return Astro.redirect(ROUTES.PROTECTED.DASHBOARD);
}
---

<Layout title="Admin Dashboard | Equipment Rental">
  <main className="flex min-h-screen flex-col items-center justify-center p-24">
    <h1 className="text-4xl font-bold">Admin Dashboard</h1>
    <p className="mt-4 text-xl">Welcome, {user.email}!</p>
    <p className="mt-2 text-muted-foreground">Role: {userRole}</p>
    
    <div className="mt-8 grid grid-cols-2 gap-4">
      <a href="/admin/reservations" className="px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 text-center">
        Manage Reservations
      </a>
      <a href="/admin/equipment" className="px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 text-center">
        Manage Equipment
      </a>
      {userRole === SUPER_ADMIN_ROLE && (
        <a href="/admin/users" className="px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 text-center">
          Manage Users
        </a>
      )}
      <a href="/admin/analytics" className="px-4 py-2 bg-secondary text-secondary-foreground rounded-md hover:bg-secondary/90 text-center">
        Analytics
      </a>
    </div>
  </main>
</Layout>
