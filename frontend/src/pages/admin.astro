---
import Layout from '../layouts/Layout.astro';

// Check if user is authenticated - middleware handles this
const user = Astro.locals.user;
const sessionInfo = Astro.locals.sessionInfo;

console.log(`[ADMIN_PAGE] Accessing page. User: ${user?.email}`);

if (!user) {
  console.log(`[ADMIN_PAGE] No user found. Redirecting to /login`);
  return Astro.redirect('/login');
}

// Get role from sessionInfo (authoritative) or fallback to user_metadata
const userRole = sessionInfo?.role || user.user_metadata?.role;
console.log(`[ADMIN_PAGE] User Role: ${userRole} (from sessionInfo: ${sessionInfo?.role}, from metadata: ${user.user_metadata?.role})`);

if (userRole !== 'admin' && userRole !== 'super_admin') {
  console.log(`[ADMIN_PAGE] Invalid role. Redirecting to /dashboard`);
  return Astro.redirect('/dashboard');
}
---

<Layout title="Admin Dashboard | Equipment Rental">
  <main class="flex min-h-screen flex-col items-center justify-center p-24">
    <h1 class="text-4xl font-bold">Admin Dashboard</h1>
    <p class="mt-4 text-xl">Welcome, {user.email}!</p>
    <p class="mt-2 text-muted-foreground">Role: {userRole}</p>
    
    <div class="mt-8 grid grid-cols-2 gap-4">
      <a href="/admin/reservations" class="px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 text-center">
        Manage Reservations
      </a>
      <a href="/admin/equipment" class="px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 text-center">
        Manage Equipment
      </a>
      {userRole === 'super_admin' && (
        <a href="/admin/users" class="px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 text-center">
          Manage Users
        </a>
      )}
      <a href="/admin/analytics" class="px-4 py-2 bg-secondary text-secondary-foreground rounded-md hover:bg-secondary/90 text-center">
        Analytics
      </a>
    </div>
  </main>
</Layout>
