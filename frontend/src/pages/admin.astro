---
/**
 * Admin Dashboard Page - Admin home page
 * Displays admin dashboard with quick actions.
 */
import AdminLayout from '../layouts/AdminLayout.astro';
import { ROUTES } from '../lib/config/routes';
import { ADMIN_ROLE, SUPER_ADMIN_ROLE } from '../lib/auth/roles';

const user = Astro.locals.user;
const sessionInfo = Astro.locals.sessionInfo;

if (!user) {
  return Astro.redirect(ROUTES.PUBLIC.LOGIN);
}

if (!sessionInfo || !sessionInfo.role) {
  return Astro.redirect(ROUTES.PUBLIC.LOGIN);
}

const userRole = sessionInfo.role;

if (userRole !== ADMIN_ROLE && userRole !== SUPER_ADMIN_ROLE) {
  return Astro.redirect(ROUTES.PROTECTED.DASHBOARD);
}
---

<AdminLayout title="Admin Dashboard | Magazyn" showBreadcrumbs={false}>
  <div className="flex flex-col items-center justify-center min-h-[60vh] text-center">
    <h1 className="text-4xl font-bold mb-4">Admin Dashboard</h1>
    <p className="text-xl text-muted-foreground mb-2">{user.email}</p>
    <p className="text-muted-foreground mb-8">
      Role: <span className="font-semibold capitalize">{userRole.replace('_', ' ')}</span>
    </p>
    
    <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 w-full max-w-4xl">
      <a 
        href={ROUTES.PROTECTED.ADMIN_RESERVATIONS}
        className="flex flex-col items-center p-6 rounded-lg border bg-card hover:bg-accent transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className="mb-3 text-muted-foreground">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span className="font-medium">Reservations</span>
      </a>
      <a 
        href={ROUTES.PROTECTED.ADMIN_EQUIPMENT}
        className="flex flex-col items-center p-6 rounded-lg border bg-card hover:bg-accent transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className="mb-3 text-muted-foreground">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
        </svg>
        <span className="font-medium">Equipment</span>
      </a>
      {userRole === SUPER_ADMIN_ROLE && (
        <a 
          href={ROUTES.PROTECTED.ADMIN_USERS}
          className="flex flex-col items-center p-6 rounded-lg border bg-card hover:bg-accent transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className="mb-3 text-muted-foreground">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          <span className="font-medium">Users</span>
        </a>
      )}
      <a 
        href={ROUTES.PROTECTED.ADMIN_ANALYTICS}
        className="flex flex-col items-center p-6 rounded-lg border bg-card hover:bg-accent transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className="mb-3 text-muted-foreground">
          <line x1="12" y1="20" x2="12" y2="10"></line>
          <line x1="18" y1="20" x2="18" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="16"></line>
        </svg>
        <span className="font-medium">Analytics</span>
      </a>
    </div>
  </div>
</AdminLayout>
