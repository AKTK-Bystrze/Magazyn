---
import Layout from '../layouts/Layout.astro';
import { getDefaultRouteForUser } from '../lib/auth/redirect-manager';
import { ROUTES } from '../lib/config/routes';

const user = Astro.locals.user;
const sessionInfo = Astro.locals.sessionInfo;

if (!user) {
  return Astro.redirect(ROUTES.PUBLIC.LOGIN);
}

if (sessionInfo && sessionInfo.isEnabled) {
  const defaultRoute = getDefaultRouteForUser(user, sessionInfo);
  return Astro.redirect(defaultRoute);
}
---

<Layout title="Welcome | Equipment Rental">
	<main class="flex min-h-screen flex-col items-center justify-center p-24">
		<h1 class="text-4xl font-bold">Welcome to Equipment Rental</h1>
		<p class="mt-4 text-xl">Redirecting...</p>
	</main>
</Layout>
