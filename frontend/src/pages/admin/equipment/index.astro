---
export const prerender = false;

/**
 * Admin Equipment Page
 * Allows administrators to browse equipment and add items to cart for reservation creation.
 * Uses the shared EquipmentSearchContainer with admin-specific checkout routing.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import EquipmentSearchContainer from '@/components/equipment/EquipmentSearchContainer';
import { ROUTES } from '../../../lib/config/routes';
import { ADMIN_ROLE, SUPER_ADMIN_ROLE } from '../../../lib/auth/roles';

const user = Astro.locals.user;
const sessionInfo = Astro.locals.sessionInfo;

// Require authentication
if (!user) {
  return Astro.redirect(ROUTES.PUBLIC.LOGIN);
}

// Require admin role
if (!sessionInfo || (sessionInfo.role !== ADMIN_ROLE && sessionInfo.role !== SUPER_ADMIN_ROLE)) {
  return Astro.redirect(ROUTES.PROTECTED.DASHBOARD);
}
---

<AdminLayout title="Browse Equipment | Magazyn">
  <EquipmentSearchContainer
    client:only="react"
    checkoutPath={ROUTES.PROTECTED.ADMIN_RESERVATIONS_CREATE}
    isAdmin={true}
  />
</AdminLayout>
