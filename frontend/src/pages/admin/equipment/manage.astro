---
export const prerender = false;

/**
 * Admin Equipment Manager Page
 * Allows administrators to:
 * - View all equipment with search/filter
 * - Add new equipment
 * - Edit existing equipment
 * - Archive equipment
 * - View equipment details and maintenance history
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { EquipmentManagerContainer } from '@/components/equipment/EquipmentManagerContainer';
import { ROUTES } from '../../../lib/config/routes';
import { ADMIN_ROLE, SUPER_ADMIN_ROLE } from '../../../lib/auth/roles';

const user = Astro.locals.user;
const sessionInfo = Astro.locals.sessionInfo;

// Require authentication
if (!user) {
  return Astro.redirect(ROUTES.PUBLIC.LOGIN);
}

// Require admin role
if (!sessionInfo || (sessionInfo.role !== ADMIN_ROLE && sessionInfo.role !== SUPER_ADMIN_ROLE)) {
  return Astro.redirect(ROUTES.PROTECTED.DASHBOARD);
}
---

<AdminLayout title="Equipment Manager | Magazyn">
  <EquipmentManagerContainer client:load />
</AdminLayout>
