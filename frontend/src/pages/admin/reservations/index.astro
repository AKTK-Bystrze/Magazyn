---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import { ReservationListContainer } from "@/components/reservations/ReservationListContainer";
import { ROUTES } from "@/lib/config/routes";
import { isAdmin } from "@/lib/auth/roles";

const { user, sessionInfo } = Astro.locals;

if (!user || !sessionInfo) {
  return Astro.redirect(
    `${ROUTES.PUBLIC.LOGIN}?redirect=${encodeURIComponent(ROUTES.PROTECTED.ADMIN_RESERVATIONS)}`
  );
}

if (!isAdmin(sessionInfo.role)) {
  return Astro.redirect(ROUTES.PROTECTED.DASHBOARD);
}
---

<AdminLayout title="Zarządzanie Rezerwacjami | Magazyn Admin">
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">Zarządzanie Rezerwacjami</h1>
      <p class="text-muted-foreground mt-1">
        Przeglądaj i zarządzaj wszystkimi rezerwacjami w systemie
      </p>
    </div>

    <ReservationListContainer
      mode="admin"
      currentUserId={user.id}
      currentUserBalance={sessionInfo.creditBalance}
      initialFilters={{ scope: "all" }}
      client:load
    />
  </div>
</AdminLayout>
