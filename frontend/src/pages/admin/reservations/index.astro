---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { ReservationListContainer } from '@/components/reservations/ReservationListContainer';
import { ROUTES } from '@/lib/config/routes';
import { Button } from '@/components/ui/button';

const { user, sessionInfo } = Astro.locals;

// Redirect if not authenticated
if (!user || !sessionInfo) {
  return Astro.redirect(`${ROUTES.PUBLIC.LOGIN}?redirect=${encodeURIComponent(ROUTES.PROTECTED.ADMIN_RESERVATIONS)}`);
}

// Check for admin role
const isAdmin = sessionInfo.role === 'admin' || sessionInfo.role === 'super_admin';
if (!isAdmin) {
  return Astro.redirect(ROUTES.PROTECTED.DASHBOARD);
}
---

<Layout title="Reservations Manager | Magazyn Admin">
  <div class="container mx-auto py-8 px-4 max-w-7xl">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">Reservations Manager</h1>
        <p class="text-muted-foreground mt-1">
          View and manage all reservations across the system
        </p>
      </div>
      <a href={ROUTES.PROTECTED.ADMIN}>
        <Button variant="outline">
          ← Back to Admin
        </Button>
      </a>
    </div>

    <!-- Reservation List (Admin Mode) -->
    <ReservationListContainer mode="admin" client:load />
  </div>
</Layout>
