---
export const prerender = false;

/**
 * Admin Reservation Create Page
 * Allows administrators to create reservations on behalf of other users.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ReservationCartView } from '@/components/reservations/ReservationCartView';
import { ROUTES } from '@/lib/config/routes';
import { ADMIN_ROLE, SUPER_ADMIN_ROLE } from '@/lib/auth/roles';

const { user, sessionInfo } = Astro.locals;

// Require authentication
if (!user || !sessionInfo) {
  return Astro.redirect(`${ROUTES.PUBLIC.LOGIN}?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

// Require admin role
if (sessionInfo.role !== ADMIN_ROLE && sessionInfo.role !== SUPER_ADMIN_ROLE) {
  return Astro.redirect(ROUTES.PROTECTED.DASHBOARD);
}
---

<AdminLayout title="Create Reservation | Magazyn">
  <div className="min-h-screen bg-background">
    <ReservationCartView
      client:only="react"
      initialCreditBalance={sessionInfo.creditBalance}
      isAdmin={true}
      successRedirectPath={ROUTES.PROTECTED.ADMIN_RESERVATIONS}
      initialSelectedUserId={sessionInfo.userId}
      initialSelectedUserCreditBalance={sessionInfo.creditBalance}
      equipmentBrowsePath={ROUTES.PROTECTED.ADMIN_EQUIPMENT}
    />
  </div>
</AdminLayout>
