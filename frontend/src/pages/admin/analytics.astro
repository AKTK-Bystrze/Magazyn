---
/**
 * Admin Analytics Page - Mock implementation
 * Displays "Coming Soon" placeholder until feature is implemented.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { ROUTES } from '../../lib/config/routes';
import { ADMIN_ROLE, SUPER_ADMIN_ROLE } from '../../lib/auth/roles';

const user = Astro.locals.user;
const sessionInfo = Astro.locals.sessionInfo;

if (!user) {
  return Astro.redirect(ROUTES.PUBLIC.LOGIN);
}

if (!sessionInfo || (sessionInfo.role !== ADMIN_ROLE && sessionInfo.role !== SUPER_ADMIN_ROLE)) {
  return Astro.redirect(ROUTES.PROTECTED.DASHBOARD);
}
---

<AdminLayout title="Analytics | Magazyn">
  <div className="flex flex-col items-center justify-center min-h-[60vh] text-center">
    <div className="rounded-full bg-muted p-6 mb-6">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="48"
        height="48"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        strokeWidth="2"
        strokeLinecap="round"
        strokeLinejoin="round"
        className="text-muted-foreground"
      >
        <line x1="12" y1="20" x2="12" y2="10"></line>
        <line x1="18" y1="20" x2="18" y2="4"></line>
        <line x1="6" y1="20" x2="6" y2="16"></line>
      </svg>
    </div>
    <h1 className="text-3xl font-bold mb-2">Analytics</h1>
    <p className="text-muted-foreground mb-6 max-w-md">
      View usage statistics and reports. This feature is coming soon.
    </p>
    <a 
      href={ROUTES.PROTECTED.ADMIN}
      className="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground h-10 px-4 py-2 hover:bg-primary/90"
    >
      Back to Admin Dashboard
    </a>
  </div>
</AdminLayout>
