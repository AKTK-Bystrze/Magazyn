---
/**
 * Admin Users Page - User Management
 * SuperAdmin: Can view, create, and edit users
 * Admin: Can view users only
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import { UserListContainer } from "../../components/users/UserListContainer";
import { ROUTES } from "../../lib/config/routes";
import { isAdmin, isSuperAdmin } from "../../lib/auth/roles";

const user = Astro.locals.user;
const sessionInfo = Astro.locals.sessionInfo;

if (!user) {
  return Astro.redirect(ROUTES.PUBLIC.LOGIN);
}

if (!sessionInfo || !isAdmin(sessionInfo.role)) {
  return Astro.redirect(ROUTES.PROTECTED.DASHBOARD);
}
---

<AdminLayout title="Manage Users | Magazyn">
  <div class="space-y-6">
    <UserListContainer client:load isSuperAdmin={isSuperAdmin(sessionInfo.role)} />
  </div>
</AdminLayout>
