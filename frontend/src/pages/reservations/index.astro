---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { Alert, AlertDescription } from '@/components/ui/alert';
import { CheckCircle2 } from 'lucide-react';

const { user, sessionInfo } = Astro.locals;

if (!user || !sessionInfo) {
  return Astro.redirect('/login?redirect=/reservations');
}

const success = Astro.url.searchParams.get('success') === 'true';
---

<Layout title="My Reservations | Magazyn">
  <div class="container mx-auto py-8 px-4 max-w-7xl">
    <h1 class="text-3xl font-bold tracking-tight mb-6">My Reservations</h1>

    {success && (
      <Alert className="mb-6 border-green-500 bg-green-50 dark:bg-green-950">
        <CheckCircle2 className="h-4 w-4 text-green-600" />
        <AlertDescription className="text-green-800 dark:text-green-200">
          <strong>Success!</strong> Your reservation has been created successfully.
        </AlertDescription>
      </Alert>
    )}

    <div class="bg-card rounded-lg border shadow-sm p-8 text-center">
      <p class="text-muted-foreground">
        Reservation list view coming soon...
      </p>
      <a href="/equipment" class="inline-block mt-4 text-primary hover:underline">
        ← Back to Equipment
      </a>
    </div>
  </div>
</Layout>
