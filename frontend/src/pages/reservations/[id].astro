---
export const prerender = false;

import AppLayout from "@/layouts/AppLayout.astro";
import { ReservationDetailsView } from "@/components/reservations/ReservationDetailsView";
import { ROUTES } from "@/lib/config/routes";
import { isAdmin } from "@/lib/auth/roles";

const { user, sessionInfo } = Astro.locals;

if (!user || !sessionInfo) {
  return Astro.redirect(
    `${ROUTES.PUBLIC.LOGIN}?redirect=${encodeURIComponent(Astro.url.pathname)}`
  );
}

const { id } = Astro.params;

if (!id) {
  return Astro.redirect(ROUTES.PROTECTED.RESERVATIONS);
}
---

<AppLayout title="Reservation Details | Magazyn">
  <div class="container mx-auto py-8 px-4 max-w-4xl">
    <ReservationDetailsView
      reservationId={id}
      currentUserId={user.id}
      currentUserBalance={sessionInfo.creditBalance}
      isAdmin={isAdmin(sessionInfo.role)}
      client:only="react"
    />
  </div>
</AppLayout>
