---
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import { ReservationDetailsContainer } from '@/components/reservations/ReservationDetailsContainer';
import { ROUTES } from '@/lib/config/routes';
import { USER_ROLE } from '@/lib/config/constants';

const { user, sessionInfo } = Astro.locals;

if (!user || !sessionInfo) {
  return Astro.redirect(`${ROUTES.PUBLIC.LOGIN}?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

// Extract reservation ID from URL params
const { id } = Astro.params;

if (!id) {
  return Astro.redirect(ROUTES.PROTECTED.RESERVATIONS);
}

// Check if user is admin
const isAdmin = user.role === USER_ROLE.ADMIN || user.role === USER_ROLE.SUPER_ADMIN;
---

<AppLayout title="Reservation Details | Magazyn">
  <div class="container mx-auto py-8 px-4 max-w-4xl">
    <ReservationDetailsContainer 
      reservationId={id}
      currentUserId={user.id}
      isAdmin={isAdmin}
      client:only="react"
    />
  </div>
</AppLayout>
