---
export const prerender = false;

import AppLayout from "@/layouts/AppLayout.astro";
import { ReservationCartView } from "@/components/reservations/ReservationCartView";
import { ROUTES } from "@/lib/config/routes";
import { isAdmin } from "@/lib/auth/roles";

const { user, sessionInfo } = Astro.locals;

if (!user || !sessionInfo) {
  return Astro.redirect(
    `${ROUTES.PUBLIC.LOGIN}?redirect=${encodeURIComponent(ROUTES.PROTECTED.RESERVATIONS_CREATE)}`
  );
}

const initialCreditBalance = sessionInfo.creditBalance || 0;
---

<AppLayout title="Dokończ Rezerwację | Magazyn">
  <div class="min-h-screen bg-background">
    <ReservationCartView
      client:only="react"
      initialCreditBalance={initialCreditBalance}
      isAdmin={isAdmin(sessionInfo.role)}
    />
  </div>
</AppLayout>
