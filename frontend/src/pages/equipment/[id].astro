---
export const prerender = false;

import AppLayout from "@/layouts/AppLayout.astro";
import { EquipmentDetailsView } from "@/components/equipment/EquipmentDetailsView";
import { ROUTES } from "@/lib/config/routes";
import { isAdmin } from "@/lib/auth/roles";

const { sessionInfo, user } = Astro.locals;
const { id } = Astro.params;

if (!id) {
  return Astro.redirect(ROUTES.PUBLIC.EQUIPMENT);
}

const adminUser = isAdmin(sessionInfo?.role);
---

<AppLayout title="Szczegóły Sprzętu | Magazyn">
  <div class="container mx-auto py-8 px-4 max-w-4xl">
    <EquipmentDetailsView
      equipmentId={id}
      isAdmin={adminUser}
      currentUserId={user?.id}
      client:only="react"
    />
  </div>
</AppLayout>
