# =============================================================================
# Supabase Configuration
# =============================================================================
# URL of your Supabase project (e.g., https://yourproject.supabase.co)
VITE_SUPABASE_URL=

# Anonymous/public key for Supabase client-side authentication
# Safe to expose in client-side code
VITE_SUPABASE_ANON_KEY=

# Alternative Supabase configuration (used by backend if VITE_ vars not set)
# These are the primary variables for backend services
SUPABASE_URL=
SUPABASE_KEY=

# Service role key for backend server operations
# CRITICAL: Keep this secret! Never expose in client-side code
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Backend API Configuration
# =============================================================================
# Backend API URL - used by frontend to communicate with Go backend
# For development: http://localhost:8080
# For production: Your deployed backend URL
PUBLIC_BACKEND_URL=

# Port for the backend API server
# Default: 8080
PORT=8080

# =============================================================================
# Logging Configuration
# =============================================================================
# Logging verbosity level
# Valid values: DEBUG, INFO, WARN, ERROR
# Default: INFO
LOG_LEVEL=INFO

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed CORS origins
# For development: http://localhost:4321,http://localhost:3000
# For production: Your frontend domain(s)
# Default (if not set): http://localhost:4321,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000

# =============================================================================
# Application Configuration
# =============================================================================
# Public URL where the frontend application is hosted
# Used for CORS, redirects, and magic link generation
PUBLIC_APP_URL=

# =============================================================================
# Advanced Configuration (Optional)
# =============================================================================
# Override path to .env file (useful for testing)
# Default: ../.env
# ENV_FILE_PATH=../.env