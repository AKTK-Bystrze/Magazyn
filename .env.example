# =============================================================================
# Environment Configuration
# =============================================================================
# Get Supabase credentials:
#   Local:  npx supabase status
#   Remote: https://supabase.com/dashboard → Settings → API
# =============================================================================

# Supabase Database
# Local:  http://127.0.0.1:54321
# Remote: https://xxxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anon Key
# Local:  From `npx supabase status`
# Remote: From Supabase Dashboard
PUBLIC_SUPABASE_ANON_KEY=<annon-key>

# Supabase Service Role Key (SECRET - backend only)
# Local:  From `npx supabase status`
# Remote: From Supabase Dashboard
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Backend URL
PUBLIC_BACKEND_URL=http://localhost:8080

# Backend Port (inside container)
PORT=8080

# App URL
# No Docker: http://localhost:4321 (Astro dev server)
# Docker:    http://localhost (via Caddy)
PUBLIC_APP_URL=http://localhost:4321

# CORS Origins
# No Docker: Include all dev server ports
# Docker:    Include localhost (Caddy port 80)
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000,http://localhost

LOG_LEVEL=DEBUG

# Caddy Configuration
# Docker only: Caddyfile.test (local) or Caddyfile (production)
# No Docker:   Not used
CADDY_FILE=Caddyfile.test