# =============================================================================
# REQUIRED CONFIGURATION (Must be set for the app to function)
# =============================================================================

# Supabase API URL
# How to get: Run `npx supabase status` (API URL) or Supabase Dashboard -> Settings -> API
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anon Key (public API key)
# How to get: Run `npx supabase status` (anon key) or Supabase Dashboard -> Settings -> API
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx

# Supabase Service Role Key (admin privileges, backend only)
# How to get: Run `npx supabase status` (service_role key) or Supabase Dashboard -> Settings -> API
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxx

# Session Encryption Key (32-byte secret hex for cookie encryption)
# How to get: Run `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_ENCRYPTION_KEY=5982495262fa238e9afa4d1d8ab3fccc1be1e5c30c39c82763f5b2ee6659c437

# Backend API URL (as accessed by browser/frontend)
# Local: http://localhost:8080 | Docker/Caddy: http://localhost/api
PUBLIC_BACKEND_URL=http://localhost:8080

# Frontend Web Application URL
# Local: http://localhost:4321 | Docker/Caddy: http://localhost
PUBLIC_APP_URL=http://localhost:4321

# Backend Port (internal listener inside container/local)
# Default: 8080
PORT=8080

# Allowed CORS Origins (comma-separated origins allowed to call backend)
# Local: http://localhost:4321,http://localhost:3000 | Docker: http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000,http://localhost

# Direct PostgreSQL connection string (for migrations and scripts)
# How to get: Run `npx supabase status` (DB URL)
DB_CONNECTION_STRING=postgresql://postgres:postgres@127.0.0.1:54322/postgres


# =============================================================================
# OPTIONAL CONFIGURATION (Docker, Ports, Overrides, Testing)
# =============================================================================

# --- Docker & Reverse Proxy ---

# Internal Supabase URL for the Docker backend/frontend to reach Supabase on the host.
# Set this when running the application with Docker Compose; keep PUBLIC_SUPABASE_URL
# on 127.0.0.1 so browsers on the host can reach Supabase.
# How to get: Use host.docker.internal with Supabase API port
# INTERNAL_SUPABASE_URL=http://host.docker.internal:54321

# Caddy Configuration File
# How to get: Use Caddyfile.test (local test) or Caddyfile (prod)
CADDY_FILE=Caddyfile.test

# Caddy Host Port (external port mapped to reverse proxy)
# How to get: Set to 80 (standard HTTP) or choose an unused host port
CADDY_PORT=80

# --- Port Overrides / Dynamic Ports ---

# Supabase API Gateway port
# How to get: Defined in supabase/config.toml under [api] port (default: 54321)
SUPABASE_API_PORT=54321

# Supabase PostgreSQL database port
# How to get: Defined in supabase/config.toml under [db] port (default: 54322)
SUPABASE_DB_PORT=54322

# Supabase Studio Web UI port
# How to get: Defined in supabase/config.toml under [studio] port (default: 54323)
SUPABASE_STUDIO_PORT=54323

# Supabase Inbucket/Mailpit local email web client port
# How to get: Defined in supabase/config.toml under [inbucket] port (default: 54324)
SUPABASE_MAILPIT_PORT=54324

# Host port for backend container
# How to get: Set to 8080 or custom port if 8080 is in use
BACKEND_PORT=8080

# Host port for frontend dev server
# How to get: Set to 4321 or custom port if 4321 is in use
FRONTEND_PORT=4321

# --- Testing & Diagnostics ---

# Playwright E2E base test URL
# How to get: URL where test stack runs (default: http://localhost)
# E2E_BASE_URL=http://localhost

# Playwright test user credentials (seeded test account)
# How to get: Use credentials seeded via supabase/seed.sql
# E2E_TEST_EMAIL=test.user@example.com
# E2E_TEST_PASSWORD=TestSecurePassword123!

# Sanity Test User Credentials (automated post-deploy check)
# SANITY_TEST_USER_EMAIL=admin@example.com
# SANITY_TEST_USER_PASSWORD=YourSecurePassword123!

# Log Level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=DEBUG
