# Supabase: URL and Public Key (Frontend & Backend)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Supabase: Admin Key (Backend only - SECRET)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend API: Server connection and port
PUBLIC_BACKEND_URL=http://localhost:8080
PORT=8080

# Logging: Verbosity (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# CORS: Allowed frontend origins for API access
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000

# App: Frontend base URL for redirects and magic links
PUBLIC_APP_URL=http://localhost:4321

# Advanced: Custom .env file path override
# ENV_FILE_PATH=../.env