DROP TABLE IF EXISTS users;
DROP TABLE IF EXISTS items;
DROP TABLE IF EXISTS reservations;

CREATE TABLE IF NOT EXISTS users (
    u_id INTEGER PRIMARY KEY AUTOINCREMENT,
    u_username TEXT NOT NULL UNIQUE,
    u_password_hash TEXT,
    u_role TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS items (
    i_id INTEGER PRIMARY KEY AUTOINCREMENT,
    i_name TEXT NOT NULL UNIQUE,
    i_description TEXT,
    i_status TEXT CHECK (i_status IN ('ok', 'broken', 'hidden')) NOT NULL DEFAULT 'ok'
);

CREATE TABLE IF NOT EXISTS reservations (
    r_id INTEGER PRIMARY KEY AUTOINCREMENT,
    r_item_id INTEGER NOT NULL,
    r_user_id INTEGER NOT NULL,
    r_start_time DATETIME NOT NULL,
    r_end_time DATETIME CHECK ( r_end_time > r_start_time ) NOT NULL,
    r_status TEXT CHECK ( r_status IN ('pending', 'approved', 'denied')) NOT NULL DEFAULT 'pending',
		r_created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (r_item_id) REFERENCES items (i_id),
    FOREIGN KEY (r_user_id) REFERENCES users (u_id)
);

