// Minimal Grafana Alloy config for scraping local Caddy and Go endpoints
logging {
  level  = "info"
  format = "json"
}

prometheus.scrape "magazyn_caddy" {
  targets = [{"__address__" = "caddy:2019"}]
  scheme = "http"
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "magazyn_backend" {
  targets = [{"__address__" = "backend:9091"}]
  metrics_path = "/metrics"
  scheme = "http"
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_REMOTE_WRITE_URL")
    basic_auth {
      username = sys.env("GRAFANA_REMOTE_WRITE_USERNAME")
      password = sys.env("GRAFANA_REMOTE_WRITE_PASSWORD")
    }
  }
}
