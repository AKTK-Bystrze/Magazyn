# Cloudflare Origin Certificate Caddyfile
# Full (strict) SSL: Cloudflare <-> Caddy with Origin Certificate

{
    # Disable auto-HTTPS - Cloudflare Origin Certificate
    auto_https off

    # Enable global Caddy metrics
    servers {
        metrics
    }
}

:443 {
    # Use Cloudflare Origin Certificate
    tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key



    # Proxy /api requests to the Go backend container
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy backend:8080
    }

    # Proxy all other requests to the Astro frontend container
    handle /* {
        reverse_proxy frontend:4321
    }

    # Enable logging
    log {
        output stdout
        format json
    }
}

:2019 {
    # Expose metrics to internal network only (Alloy will scrape this)
    handle /metrics {
        metrics
    }
}
