# Production Caddyfile
# For https://magazynbystrze.pl/

{
	# Email for Let's Encrypt (for certificate notifications)
	email appbystrze@gmail.com
	
	# Enable automatic HTTPS (default, but explicit for clarity)
	auto_https on
}

magazynbystrze.pl, www.magazynbystrze.pl {
	# Redirect www to non-www
	@www host www.magazynbystrze.pl
	redir @www https://magazynbystrze.pl{uri} permanent

	# Security headers
	header {
		# Prevent clickjacking
		X-Frame-Options "SAMEORIGIN"
		
		# XSS protection
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		
		# Referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"
		
		# Permissions policy (disable unused features)
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		
		# Strict transport security (HSTS) - 1 year
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		
		# Remove server identification
		-Server
	}

	# Rate limiting for API endpoints
	rate_limit {
		zone api {
			key {remote_host}
			events 100
			window 1m
		}
	}

	# Proxy /api requests to the Go backend
	handle /api/* {
		# Apply rate limiting to API
		rate_limit api
		
		# Strip /api prefix before forwarding
		uri strip_prefix /api
		
		# Forward to backend with proper headers
		reverse_proxy backend:8080 {
			# Health check
			health_uri /health
			health_interval 10s
			health_timeout 5s
			
			# Timeouts
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
			
			# Preserve headers
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Proxy all other requests to frontend
	handle /* {
		reverse_proxy frontend:4321 {
			# Health check
			health_uri /
			health_interval 10s
			health_timeout 5s
			
			# Timeouts
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
			
			# Preserve headers
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Enable access logging
	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}

	# Enable error logging
	log {
		output file /var/log/caddy/error.log {
			roll_size 100mb
			roll_keep 5
			roll_keep_for 720h
		}
		level ERROR
		format json
	}
}
