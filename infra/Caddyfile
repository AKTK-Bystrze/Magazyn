# Cloudflare Origin Certificate Caddyfile
# Full (strict) SSL: Cloudflare <-> Caddy with Origin Certificate
{
	# Disable auto-HTTPS - Cloudflare Origin Certificate
	auto_https off

	# Enable global Caddy metrics
	servers {
		metrics
	}

	# Standardized global/system logger
	log default {
		output stdout
		format json {
			time_format iso8601
			time_key time
			level_format upper
		}
	}
}

:443 {
	# Use Cloudflare Origin Certificate
	tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key

	# Static assets: preserve Astro immutable caching
	@static path /_astro/* /favicon* /*.png /*.svg /*.jpg /*.jpeg /*.css /*.js /*.woff2
	handle @static {
		reverse_proxy frontend:4321 {
			transport http {
				response_header_timeout 10s
				dial_timeout 5s
			}
		}
	}

	# Dynamic pages and APIs: enforce no-store for intermediate CDNs and browsers
	handle /* {
		reverse_proxy frontend:4321 {
			transport http {
				response_header_timeout 10s
				dial_timeout 5s
			}
			header_down Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
			header_down Pragma "no-cache"
		}
	}

	# Enable logging
	log {
		output stdout
		format json {
			time_format iso8601
			time_key time
			level_format upper
		}
	}
}

:2019 {
	# Expose metrics to internal network only (Alloy will scrape this)
	handle /metrics {
		metrics
	}
}
