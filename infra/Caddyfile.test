# Testing/Development Caddyfile
# For localhost testing and E2E tests
{
	# Disable auto-HTTPS for local development
	auto_https off

	# Enable global Caddy metrics
	servers {
		metrics
	}
}

:443 {
	# Proxy /api requests to the Go backend container
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy backend:8080 {
			transport http {
				response_header_timeout 10s
				dial_timeout 5s
			}
		}
	}

	# Proxy all other requests to the Astro frontend container
	handle /* {
		reverse_proxy frontend:4321 {
			transport http {
				response_header_timeout 10s
				dial_timeout 5s
			}
		}
	}

	# Enable logging
	log {
		output stdout
	}
}

:2019 {
	# Expose metrics to internal network only (Alloy will scrape this)
	handle /metrics {
		metrics
	}
}
